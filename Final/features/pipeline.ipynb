    "def save_arrays_npz(path: str | Path, arrays: dict[str, np.ndarray]) -> Path:\n",
    "    path = Path(path)\n",
    "    path.parent.mkdir(parents=True, exist_ok=True)\n",
    "    np.savez_compressed(path, **arrays)\n",
    "    return path\n",
    "\n",
    "\n",
    "def load_arrays_npz(path: str | Path) -> dict[str, np.ndarray]:\n",
    "    arrs = np.load(path)\n",
    "    return {k: arrs[k] for k in arrs.files}\n",
    "\n",
    "\n",
    "def family_cache_dir(site_id: str, family_name: str, data_signature: str, config_signature: str) -> Path:\n",
    "    return stage_cache_dir(\n",
    "        fe_cfg,\n",
    "        stage_name=\"family_result\",\n",
    "        site_id=site_id,\n",
    "        source_name=family_name,\n",
    "        data_signature=data_signature,\n",
    "        config_signature=config_signature,\n",
    "    )\n",
    "\n",
    "\n",
    "def family_data_signature(site_id: str, bundle: SourceRasterBundle, family_name: str) -> str:\n",
    "    return hash_payload({\n",
    "        \"site_id\": site_id,\n",
    "        \"source_name\": bundle.source_name,\n",
    "        \"family_name\": family_name,\n",
    "        \"bundle_shape\": bundle.shape,\n",
    "        \"bundle_bands\": sorted(bundle.arrays.keys()),\n",
    "        \"metadata\": bundle.metadata,\n",
    "    })\n",
    "\n",
    "\n",
    "def family_config_signature(family_name: str) -> str:\n",
    "    payload = {\n",
    "        \"family_name\": family_name,\n",
    "        \"naip_config\": asdict(fe_cfg.naip),\n",
    "        \"version\": fe_cfg.version,\n",
    "    }\n",
    "    return hash_payload(payload)\n",
    "\n",
    "\n",
    "def run_or_load_naip_family(bundle: SourceRasterBundle, family_name: str, force_refresh: bool = False) -> FeatureFamilyResult:\n",
    "    data_sig = family_data_signature(bundle.site_id, bundle, family_name)\n",
    "    config_sig = family_config_signature(family_name)\n",
    "    cache_dir = family_cache_dir(bundle.site_id, family_name, data_sig, config_sig)\n",
    "\n",
    "    manifest_path = cache_dir / \"manifest.json\"\n",
    "    npz_path = cache_dir / f\"{family_name}.npz\"\n",
    "    meta_path = cache_dir / f\"{family_name}_meta.json\"\n",
    "\n",
    "    if (not force_refresh) and has_valid_stage_cache(\n",
    "        manifest_path,\n",
    "        expected_stage_name=\"family_result\",\n",
    "        expected_data_signature=data_sig,\n",
    "        expected_config_signature=config_sig,\n",
    "    ) and npz_path.exists() and meta_path.exists():\n",
    "        log_info(\n",
    "            \"CACHE HIT | site=%s | source=naip | family=%s | npz=%s\",\n",
    "            bundle.site_id, family_name, npz_path\n",
    "        )\n",
    "        meta = read_json(meta_path)\n",
    "        arrays = load_arrays_npz(npz_path)\n",
    "        return FeatureFamilyResult(\n",
    "            site_id=bundle.site_id,\n",
    "            source_name=\"naip\",\n",
    "            family_name=family_name,\n",
    "            arrays=arrays,\n",
    "            metadata=meta,\n",
    "        )\n",
    "\n",
    "    log_info(\n",
    "        \"CACHE MISS | site=%s | source=naip | family=%s\",\n",
    "        bundle.site_id, family_name\n",
    "    )\n",
    "    runner = NAIP_FAMILY_RUNNERS[family_name]\n",
    "    result = runner(bundle)\n",
    "\n",
    "    if fe_cfg.persistence.persist_family_results:\n",
    "        save_arrays_npz(npz_path, result.arrays)\n",
    "        write_json(meta_path, result.metadata)\n",
    "        write_stage_manifest(\n",
    "            manifest_path,\n",
    "            stage_name=\"family_result\",\n",
    "            site_id=bundle.site_id,\n",
    "            source_name=family_name,\n",
    "            data_signature=data_sig,\n",
    "            config_signature=config_sig,\n",
    "            artifact_paths={\"npz_path\": str(npz_path), \"meta_path\": str(meta_path)},\n",
    "            success=True,\n",
    "            notes=[f\"Cached family result for {family_name}\"],\n",
    "        )\n",
    "\n",
    "    return result\n",
    "\n",
    "def merged_stack_cache_dir(site_id: str, data_signature: str, config_signature: str) -> Path:\n",
    "    return stage_cache_dir(\n",
    "        fe_cfg,\n",
    "        stage_name=\"merged_stack\",\n",
    "        site_id=site_id,\n",
    "        source_name=\"naip\",\n",
    "        data_signature=data_signature,\n",
    "        config_signature=config_signature,\n",
    "    )\n",
    "\n",
    "\n",
    "def merged_stack_signatures(site_id: str, family_results: list[FeatureFamilyResult]) -> tuple[str, str]:\n",
    "    data_sig = hash_payload({\n",
    "        \"site_id\": site_id,\n",
    "        \"families\": [\n",
    "            {\n",
    "                \"family_name\": fr.family_name,\n",
    "                \"feature_names\": sorted(fr.arrays.keys()),\n",
    "                \"n_layers\": len(fr.arrays),\n",
    "            }\n",
    "            for fr in family_results\n",
    "        ],\n",
    "    })\n",
    "    config_sig = hash_payload({\n",
    "        \"naip_config\": asdict(fe_cfg.naip),\n",
    "        \"version\": fe_cfg.version,\n",
    "    })\n",
    "    return data_sig, config_sig\n",
    "\n",
    "\n",
    "def persist_merged_stack(site_id: str, merged: dict[str, np.ndarray], family_results: list[FeatureFamilyResult]) -> Path | None:\n",
    "    if not fe_cfg.persistence.persist_merged_stack:\n",
    "        return None\n",
    "\n",
    "    data_sig, config_sig = merged_stack_signatures(site_id, family_results)\n",
    "    cache_dir = merged_stack_cache_dir(site_id, data_sig, config_sig)\n",
    "    npz_path = cache_dir / \"merged_stack.npz\"\n",
    "    meta_path = cache_dir / \"merged_stack_meta.json\"\n",
    "    manifest_path = cache_dir / \"manifest.json\"\n",
    "\n",
    "    save_arrays_npz(npz_path, merged)\n",
    "    write_json(meta_path, {\n",
    "        \"site_id\": site_id,\n",
    "        \"n_layers\": len(merged),\n",
    "        \"feature_names\": sorted(merged.keys()),\n",
    "    })\n",
    "    write_stage_manifest(\n",
    "        manifest_path,\n",
    "        stage_name=\"merged_stack\",\n",
    "        site_id=site_id,\n",
    "        source_name=\"naip\",\n",
    "        data_signature=data_sig,\n",
    "        config_signature=config_sig,\n",
    "        artifact_paths={\"npz_path\": str(npz_path), \"meta_path\": str(meta_path)},\n",
    "        success=True,\n",
    "        notes=[\"Persisted merged NAIP feature stack.\"],\n",
    "    )\n",
    "    return npz_path"
   ]
  },
