   "source": [
    "def read_raster_bundle(\n",
    "    path: str | Path,\n",
    "    *,\n",
    "    site_id: str,\n",
    "    source_name: str,\n",
    "    band_names: list[str] | None = None,\n",
    ") -> SourceRasterBundle:\n",
    "    path = Path(path)\n",
    "\n",
    "    with rasterio.open(path) as src:\n",
    "        data = src.read().astype(np.float32)\n",
    "        nodata = src.nodata\n",
    "\n",
    "        if nodata is not None:\n",
    "            data = np.where(data == nodata, np.nan, data)\n",
    "\n",
    "        if band_names is None:\n",
    "            band_names = [f\"{source_name}_band_{i}\" for i in range(1, src.count + 1)]\n",
    "\n",
    "        if len(band_names) != src.count:\n",
    "            raise ValueError(\n",
    "                f\"Band name count mismatch for {path}. \"\n",
    "                f\"Expected {src.count}, got {len(band_names)}.\"\n",
    "            )\n",
    "\n",
    "        arrays = {name: data[i] for i, name in enumerate(band_names)}\n",
    "\n",
    "        return SourceRasterBundle(\n",
    "            site_id=site_id,\n",
    "            source_name=source_name,\n",
    "            arrays=arrays,\n",
    "            transform=src.transform,\n",
    "            crs=src.crs,\n",
    "            nodata=nodata,\n",
    "            metadata={\n",
    "                \"path\": str(path),\n",
    "                \"count\": src.count,\n",
    "                \"width\": src.width,\n",
    "                \"height\": src.height,\n",
    "            },\n",
    "        )\n",
    "\n",
    "\n",
    "def grid_from_bundle(bundle: SourceRasterBundle) -> CanonicalGrid:\n",
    "    h, w = bundle.shape\n",
    "    return CanonicalGrid(\n",
    "        width=w,\n",
    "        height=h,\n",
    "        transform=bundle.transform,\n",
    "        crs=bundle.crs,\n",
    "        source_name=bundle.source_name,\n",
    "        nodata=np.nan,\n",
    "    )\n",
    "\n",
    "\n",
    "def reproject_band_to_grid(\n",
    "    src_band: np.ndarray,\n",
    "    *,\n",
    "    src_transform: Affine,\n",
    "    src_crs: Any,\n",
    "    dst_grid: CanonicalGrid,\n",
    "    resampling: Resampling = Resampling.bilinear,\n",
    "    dst_nodata: float = np.nan,\n",
    ") -> np.ndarray:\n",
    "    dst = np.full((dst_grid.height, dst_grid.width), dst_nodata, dtype=np.float32)\n",
    "\n",
    "    reproject(\n",
    "        source=src_band.astype(np.float32),\n",
    "        destination=dst,\n",
    "        src_transform=src_transform,\n",
    "        src_crs=src_crs,\n",
    "        dst_transform=dst_grid.transform,\n",
    "        dst_crs=dst_grid.crs,\n",
    "        src_nodata=np.nan,\n",
    "        dst_nodata=dst_nodata,\n",
    "        resampling=resampling,\n",
    "    )\n",
    "    return dst\n",
    "\n",
    "\n",
    "def align_bundle_to_grid(\n",
    "    bundle: SourceRasterBundle,\n",
    "    *,\n",
    "    dst_grid: CanonicalGrid,\n",
    "    resampling: Resampling,\n",
    ") -> SourceRasterBundle:\n",
    "    aligned = {}\n",
    "    for band_name, band in bundle.arrays.items():\n",
    "        aligned[band_name] = reproject_band_to_grid(\n",
    "            band,\n",
    "            src_transform=bundle.transform,\n",
    "            src_crs=bundle.crs,\n",
    "            dst_grid=dst_grid,\n",
    "            resampling=resampling,\n",
    "        )\n",
    "\n",
    "    return SourceRasterBundle(\n",
    "        site_id=bundle.site_id,\n",
    "        source_name=bundle.source_name,\n",
    "        arrays=aligned,\n",
    "        transform=dst_grid.transform,\n",
    "        crs=dst_grid.crs,\n",
    "        nodata=np.nan,\n",
    "        metadata={**bundle.metadata, \"aligned_to\": dst_grid.source_name},\n",
    "    )\n",
    "\n",
    "\n",
    "def summarize_array(name: str, arr: np.ndarray) -> dict[str, Any]:\n",
    "    finite = np.isfinite(arr)\n",
    "    return {\n",
    "        \"name\": name,\n",
    "        \"shape\": arr.shape,\n",
    "        \"finite_fraction\": float(finite.mean()),\n",
    "        \"min\": float(np.nanmin(arr)) if finite.any() else np.nan,\n",
    "        \"max\": float(np.nanmax(arr)) if finite.any() else np.nan,\n",
    "        \"mean\": float(np.nanmean(arr)) if finite.any() else np.nan,\n",
    "        \"std\": float(np.nanstd(arr)) if finite.any() else np.nan,\n",
    "    }"
   ]
  },
