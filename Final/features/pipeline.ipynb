    "\n",
    "    band_names = infer_naip_band_names(assets.naip_path)\n",
    "\n",
    "    data_sig = source_data_signature(\n",
    "        site_id=site_id,\n",
    "        source_name=\"naip\",\n",
    "        asset_path=assets.naip_path,\n",
    "        extra_payload={\"band_names\": band_names},\n",
    "    )\n",
    "    config_sig = source_config_signature(\n",
    "        source_name=\"naip\",\n",
    "        family_names=fe_cfg.enabled_families[\"naip\"],\n",
    "        notebook_cfg=fe_cfg,\n",
    "    )\n",
    "\n",
    "    cache_dir = stage_cache_dir(\n",
    "        fe_cfg,\n",
    "        stage_name=\"source_bundle\",\n",
    "        site_id=site_id,\n",
    "        source_name=\"naip\",\n",
    "        data_signature=data_sig,\n",
    "        config_signature=config_sig,\n",
    "    )\n",
    "    manifest_path = cache_dir / \"manifest.json\"\n",
    "    npz_path = cache_dir / \"naip_bundle.npz\"\n",
    "    meta_path = cache_dir / \"naip_bundle_meta.json\"\n",
    "\n",
    "    if (not force_refresh) and has_valid_stage_cache(\n",
    "        manifest_path,\n",
    "        expected_stage_name=\"source_bundle\",\n",
    "        expected_data_signature=data_sig,\n",
    "        expected_config_signature=config_sig,\n",
    "    ) and npz_path.exists() and meta_path.exists():\n",
    "        meta = read_json(meta_path)\n",
    "        arrays_raw = np.load(npz_path)\n",
    "        arrays = {k: arrays_raw[k] for k in arrays_raw.files}\n",
    "\n",
    "        bundle = SourceRasterBundle(\n",
    "            site_id=site_id,\n",
    "            source_name=\"naip\",\n",
    "            arrays=arrays,\n",
    "            transform=Affine(*meta[\"transform\"]),\n",
    "            crs=meta[\"crs\"],\n",
    "            nodata=np.nan,\n",
    "            metadata=meta[\"metadata\"],\n",
    "        )\n",
    "        return bundle\n",
    "\n",
    "    bundle = read_raster_bundle(\n",
    "        assets.naip_path,\n",
    "        site_id=site_id,\n",
    "        source_name=\"naip\",\n",
    "        band_names=band_names,\n",
    "    )\n",
    "\n",
    "    if align_to_canonical:\n",
    "        if canonical_grid is None:\n",
    "            canonical_grid = build_canonical_grid_for_site(site_id, assets=assets)\n",
    "        bundle = align_bundle_to_grid(\n",
    "            bundle,\n",
    "            dst_grid=canonical_grid,\n",
    "            resampling=fe_cfg.resampling_by_source[\"naip\"],\n",
    "        )\n",
    "\n",
    "    np.savez_compressed(npz_path, **bundle.arrays)\n",
    "    write_json(\n",
    "        meta_path,\n",
    "        {\n",
    "            \"transform\": list(bundle.transform)[:6],\n",
    "            \"crs\": bundle.crs,\n",
    "            \"metadata\": bundle.metadata,\n",
    "        },\n",
    "    )\n",
    "    write_stage_manifest(\n",
    "        manifest_path,\n",
    "        stage_name=\"source_bundle\",\n",
    "        site_id=site_id,\n",
    "        source_name=\"naip\",\n",
    "        data_signature=data_sig,\n",
    "        config_signature=config_sig,\n",
    "        artifact_paths={\"npz_path\": str(npz_path), \"meta_path\": str(meta_path)},\n",
    "        success=True,\n",
    "        notes=[\"Cached NAIP source bundle.\"],\n",
    "    )\n",
    "    return bundle"
   ]
