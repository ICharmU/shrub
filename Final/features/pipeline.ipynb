    "@dataclass\n",
    "class SiteAssetBundle:\n",
    "    site_id: str\n",
    "    naip_path: Path | None = None\n",
    "    als_metadata: list[dict[str, Any]] = field(default_factory=list)\n",
    "    three_dep_path: Path | None = None\n",
    "    rap_path: Path | None = None\n",
    "    notes: list[str] = field(default_factory=list)\n",
    "\n",
    "\n",
    "def prepare_naip_asset(site_id: str, *, force_refresh: bool = False) -> Path:\n",
    "    site_base = site_to_remote_base(cfg, site_id)\n",
    "    naip_name = site_to_tif_name(site_id)\n",
    "\n",
    "    naip_local = feature_site_naip_cache_root(site_id) / naip_name\n",
    "    naip_url = f\"{site_base}/{cfg.data.naip_3dep_dir}/{naip_name}\"\n",
    "\n",
    "    use_cached = False\n",
    "    if (not force_refresh) and naip_local.exists():\n",
    "        if validate_cached_raster(naip_local):\n",
    "            LOGGER.info(\"Using cached NAIP for site=%s: %s\", site_id, naip_local)\n",
    "            use_cached = True\n",
    "        else:\n",
    "            LOGGER.warning(\"Deleting corrupt cached NAIP for site=%s: %s\", site_id, naip_local)\n",
    "            naip_local.unlink(missing_ok=True)\n",
    "\n",
    "    if not use_cached:\n",
    "        LOGGER.info(\"Downloading NAIP for site=%s to %s\", site_id, naip_local)\n",
    "        download_file(naip_url, naip_local)\n",
    "        if not validate_cached_raster(naip_local):\n",
    "            raise RuntimeError(f\"Downloaded NAIP for site={site_id} is unreadable: {naip_local}\")\n",
    "\n",
    "    return naip_local\n",
    "\n",
    "\n",
    "def prepare_als_metadata(site_id: str, *, force_refresh: bool = False) -> list[dict[str, Any]]:\n",
    "    als_cache_dir = feature_site_als_cache_root(site_id)\n",
    "    als_meta_json = als_cache_dir / \"als_metadata.json\"\n",
    "\n",
    "    if (not force_refresh) and als_meta_json.exists():\n",
    "        LOGGER.info(\"Using cached ALS metadata for site=%s: %s\", site_id, als_meta_json)\n",
    "        return json.loads(als_meta_json.read_text(encoding=\"utf-8\"))\n",
    "\n",
    "    site_base = site_to_remote_base(cfg, site_id)\n",
    "    als_url = f\"{site_base}/{cfg.data.als_dir}\"\n",
    "    als_files = list_files_with_suffix(als_url, (\".laz\", \".las\", \".copc.laz\"))\n",
    "\n",
    "    if not als_files:\n",
    "        LOGGER.warning(\"No ALS files found for site=%s at %s\", site_id, als_url)\n",
    "        return []\n",
    "\n",
    "    LOGGER.info(\"Downloading %d ALS file(s) for site=%s to extract metadata\", len(als_files), site_id)\n",
    "\n",
    "    records: list[dict[str, Any]] = []\n",
    "    scratch_dir = Path(tempfile.mkdtemp(prefix=f\"features_als_{site_id}_\"))\n",
    "\n",
    "    try:\n",
    "        for entry in als_files:\n",
    "            local_path = scratch_dir / entry[\"name\"]\n",
    "            download_file(entry[\"url\"], local_path)\n",
    "\n",
    "            meta = extract_als_metadata(local_path)\n",
    "            meta[\"source_file\"] = entry[\"name\"]\n",
    "            records.append(meta)\n",
    "\n",
    "            try:\n",
    "                local_path.unlink(missing_ok=True)\n",
    "            except Exception as e:\n",
    "                LOGGER.warning(\"Failed to remove temporary ALS file %s: %s\", local_path, e)\n",
    "    finally:\n",
    "        try:\n",
    "            scratch_dir.rmdir()\n",
    "        except Exception:\n",
    "            pass\n",
    "\n",
    "    als_meta_json.write_text(json.dumps(records, indent=2), encoding=\"utf-8\")\n",
    "    LOGGER.info(\"Cached ALS metadata for site=%s at %s\", site_id, als_meta_json)\n",
    "    return records\n",
    "\n",
    "\n",
    "def prepare_site_assets(site_id: str, *, force_refresh: bool = False) -> SiteAssetBundle:\n",
    "    bundle = SiteAssetBundle(site_id=site_id)\n",
    "\n",
    "    try:\n",
    "        bundle.naip_path = prepare_naip_asset(site_id, force_refresh=force_refresh)\n",
    "    except Exception as e:\n",
    "        bundle.notes.append(f\"NAIP unavailable: {e}\")\n",
    "\n",
    "    try:\n",
    "        bundle.als_metadata = prepare_als_metadata(site_id, force_refresh=force_refresh)\n",
    "    except Exception as e:\n",
    "        bundle.notes.append(f\"ALS metadata unavailable: {e}\")\n",
    "\n",
    "    # 3DEP and RAP are left as explicit placeholders for now.\n",
    "    bundle.notes.append(\"3DEP adapter not yet connected in notebook runtime.\")\n",
    "    bundle.notes.append(\"RAP adapter not yet connected in notebook runtime.\")\n",
    "\n",
    "    return bundle"
   ]
  },
