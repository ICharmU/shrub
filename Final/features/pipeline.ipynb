    "def feature_site_cache_root(site_id: str) -> Path:\n",
    "    root = ensure_dir(fe_cfg.cache_root / \"site_assets\" / site_id)\n",
    "    return root\n",
    "\n",
    "\n",
    "def feature_site_naip_cache_root(site_id: str) -> Path:\n",
    "    return ensure_dir(feature_site_cache_root(site_id) / \"naip\")\n",
    "\n",
    "\n",
    "def feature_site_als_cache_root(site_id: str) -> Path:\n",
    "    return ensure_dir(feature_site_cache_root(site_id) / \"als_metadata\")\n",
    "\n",
    "\n",
    "def feature_site_3dep_cache_root(site_id: str) -> Path:\n",
    "    return ensure_dir(feature_site_cache_root(site_id) / \"3dep\")\n",
    "\n",
    "\n",
    "def feature_site_rap_cache_root(site_id: str) -> Path:\n",
    "    return ensure_dir(feature_site_cache_root(site_id) / \"rap\")\n",
    "\n",
    "\n",
    "def validate_cached_raster(path: str | Path) -> bool:\n",
    "    path = Path(path)\n",
    "    if not path.exists():\n",
    "        return False\n",
    "\n",
    "    try:\n",
    "        with rasterio.open(path) as src:\n",
    "            h = max(1, min(16, src.height))\n",
    "            w = max(1, min(16, src.width))\n",
    "            src.read([1], window=Window(0, 0, w, h))\n",
    "        return True\n",
    "    except Exception as e:\n",
    "        LOGGER.warning(\"Cached raster validation failed for %s: %s\", path, e)\n",
    "        return False"
   ]
