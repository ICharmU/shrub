    "def feature_stack_frame(layer_dict: dict[str, np.ndarray]) -> pd.DataFrame:\n",
    "    rows = [summarize_array(name, arr) for name, arr in layer_dict.items()]\n",
    "    return pd.DataFrame(rows).sort_values(\"name\").reset_index(drop=True)\n",
    "\n",
    "\n",
    "def preview_naip_run(site_id: str):\n",
    "    assets = prepare_site_assets(site_id, force_refresh=fe_cfg.force_refresh_assets)\n",
    "    grid = build_canonical_grid_for_site(site_id, assets=assets)\n",
    "\n",
    "    bundle, family_results, merged = run_naip_feature_families(\n",
    "        site_id,\n",
    "        assets=assets,\n",
    "        canonical_grid=grid,\n",
    "        force_refresh=fe_cfg.force_refresh_features,\n",
    "    )\n",
    "\n",
    "    merged_npz = persist_merged_stack(site_id, merged, family_results)\n",
    "\n",
    "    site_objects = label_objects_for_site(site_id)\n",
    "    object_features = pd.DataFrame()\n",
    "    if fe_cfg.object_table_enabled and fe_cfg.object_agg.enabled and not site_objects.empty:\n",
    "        object_features = aggregate_raster_features_to_objects(\n",
    "            site_id,\n",
    "            canonical_grid=grid,\n",
    "            feature_layers=merged,\n",
    "            objects_df=site_objects,\n",
    "        )\n",
    "\n",
    "        if fe_cfg.persistence.persist_object_table and not object_features.empty:\n",
    "            out_csv = fe_cfg.summary_root / f\"{site_id}_naip_object_features.csv\"\n",
    "            object_features.to_csv(out_csv, index=False)\n",
    "            log_info(\"WROTE OBJECT TABLE | site=%s | path=%s\", site_id, out_csv)\n",
    "\n",
    "    summary_df = feature_stack_frame(merged)\n",
    "\n",
    "    if fe_cfg.persistence.write_summary_csvs:\n",
    "        summary_csv = fe_cfg.summary_root / f\"{site_id}_naip_feature_summary.csv\"\n",
    "        summary_df.to_csv(summary_csv, index=False)\n",
    "        log_info(\"WROTE SUMMARY CSV | site=%s | path=%s\", site_id, summary_csv)\n",
    "\n",
    "    if fe_cfg.persistence.write_runtime_csv:\n",
    "        rt_df = runtime_frame()\n",
    "        if not rt_df.empty:\n",
    "            rt_csv = fe_cfg.summary_root / f\"{site_id}_runtime_log.csv\"\n",
    "            rt_df.to_csv(rt_csv, index=False)\n",
    "            log_info(\"WROTE RUNTIME CSV | site=%s | path=%s\", site_id, rt_csv)\n",
    "\n",
    "    print(\"Site:\", site_id)\n",
    "    print(\"NAIP path:\", assets.naip_path)\n",
    "    print(\"Grid shape:\", (grid.height, grid.width))\n",
    "    print(\"Grid pixel size:\", grid.pixel_size)\n",
    "    print(\"Raw band names:\", list(bundle.arrays.keys()))\n",
    "    print(\"Families run:\", [r.family_name for r in family_results])\n",
    "    print(\"Total merged layers:\", len(merged))\n",
    "    print(\"Merged stack path:\", merged_npz)\n",
    "    print(\"Object feature shape:\", object_features.shape if not object_features.empty else None)\n",
    "\n",
    "    return {\n",
    "        \"assets\": assets,\n",
    "        \"grid\": grid,\n",
    "        \"bundle\": bundle,\n",
    "        \"family_results\": family_results,\n",
    "        \"merged\": merged,\n",
    "        \"merged_npz\": merged_npz,\n",
    "        \"summary\": summary_df,\n",
    "        \"object_features\": object_features,\n",
    "        \"runtime\": runtime_frame(),\n",
    "    }"
   ]
  },
