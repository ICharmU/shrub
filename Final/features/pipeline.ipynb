   "source": [
    "fe_cfg = NotebookFEConfig().resolve()\n",
    "\n",
    "RUNTIME_LOGS: list[dict[str, Any]] = []\n",
    "RUNTIME_ACCUM = defaultdict(list)\n",
    "\n",
    "\n",
    "def log_info(msg: str, *args):\n",
    "    LOGGER.info(msg, *args)\n",
    "\n",
    "\n",
    "def array_megapixels(arr: np.ndarray) -> float:\n",
    "    return float(arr.shape[0] * arr.shape[1]) / 1_000_000.0\n",
    "\n",
    "\n",
    "def arrays_megapixels(arrays: dict[str, np.ndarray]) -> float:\n",
    "    if not arrays:\n",
    "        return 0.0\n",
    "    first = next(iter(arrays.values()))\n",
    "    return array_megapixels(first)\n",
    "\n",
    "\n",
    "@contextmanager\n",
    "def timed_stage(\n",
    "    stage_name: str,\n",
    "    *,\n",
    "    site_id: str | None = None,\n",
    "    source_name: str | None = None,\n",
    "    family_name: str | None = None,\n",
    "    unit_amount: float | None = None,\n",
    "    extra: dict[str, Any] | None = None,\n",
    "):\n",
    "    start = time.perf_counter()\n",
    "\n",
    "    if fe_cfg.timing.log_start_end:\n",
    "        log_info(\n",
    "            \"START | stage=%s | site=%s | source=%s | family=%s\",\n",
    "            stage_name, site_id, source_name, family_name\n",
    "        )\n",
    "\n",
    "    try:\n",
    "        yield\n",
    "    finally:\n",
    "        duration = time.perf_counter() - start\n",
    "\n",
    "        record = {\n",
    "            \"stage_name\": stage_name,\n",
    "            \"site_id\": site_id,\n",
    "            \"source_name\": source_name,\n",
    "            \"family_name\": family_name,\n",
    "            \"duration_sec\": duration,\n",
    "            \"unit_amount\": unit_amount,\n",
    "            \"sec_per_unit\": (duration / unit_amount) if (unit_amount is not None and unit_amount > 0) else np.nan,\n",
    "            **(extra or {}),\n",
    "        }\n",
    "        RUNTIME_LOGS.append(record)\n",
    "        RUNTIME_ACCUM[stage_name].append(record)\n",
    "\n",
    "        suffix = \"\"\n",
    "        if unit_amount is not None and unit_amount > 0:\n",
    "            suffix = f\" | unit_amount={unit_amount:.3f} | sec_per_unit={duration / unit_amount:.3f}\"\n",
    "\n",
    "        log_info(\n",
    "            \"END   | stage=%s | site=%s | source=%s | family=%s | duration=%.2fs%s\",\n",
    "            stage_name, site_id, source_name, family_name, duration, suffix\n",
    "        )\n",
    "\n",
    "        if duration >= fe_cfg.timing.warn_if_seconds_over:\n",
    "            log_info(\n",
    "                \"SLOW  | stage=%s exceeded %.1fs (actual %.2fs)\",\n",
    "                stage_name, fe_cfg.timing.warn_if_seconds_over, duration\n",
    "            )\n",
    "\n",
    "\n",
    "def estimate_remaining_time(\n",
    "    stage_name: str,\n",
    "    *,\n",
    "    remaining_units: float,\n",
    ") -> float | None:\n",
    "    rows = RUNTIME_ACCUM.get(stage_name, [])\n",
    "    sec_per_unit = [r[\"sec_per_unit\"] for r in rows if np.isfinite(r.get(\"sec_per_unit\", np.nan))]\n",
    "    if not sec_per_unit:\n",
    "        return None\n",
    "    mean_rate = float(np.mean(sec_per_unit))\n",
    "    return mean_rate * remaining_units\n",
    "\n",
    "\n",
    "def runtime_frame() -> pd.DataFrame:\n",
    "    if not RUNTIME_LOGS:\n",
    "        return pd.DataFrame()\n",
    "    return pd.DataFrame(RUNTIME_LOGS)"
   ]
