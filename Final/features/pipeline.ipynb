    "SOURCE_SPECS: dict[str, SourceSpec] = {\n",
    "    \"naip\": SourceSpec(\n",
    "        name=\"naip\",\n",
    "        native_kind=\"raster\",\n",
    "        family_names=(\"raw\", \"veg_idx\", \"texture\", \"multiscale\"),\n",
    "        default_resampling=Resampling.nearest,\n",
    "        notes=\"Canonical appearance source.\",\n",
    "    ),\n",
    "    \"als\": SourceSpec(\n",
    "        name=\"als\",\n",
    "        native_kind=\"point_cloud_or_rasterized_structure\",\n",
    "        family_names=(\"height\", \"structure\", \"canopy_context\"),\n",
    "        default_resampling=Resampling.bilinear,\n",
    "        notes=\"Structural source after rasterization / aggregation.\",\n",
    "    ),\n",
    "    \"3dep\": SourceSpec(\n",
    "        name=\"3dep\",\n",
    "        native_kind=\"terrain_raster\",\n",
    "        family_names=(\"terrain\", \"terrain_context\"),\n",
    "        default_resampling=Resampling.bilinear,\n",
    "        notes=\"Terrain/site context source.\",\n",
    "    ),\n",
    "    \"rap\": SourceSpec(\n",
    "        name=\"rap\",\n",
    "        native_kind=\"coarse_raster_prior\",\n",
    "        family_names=(\"prior\",),\n",
    "        default_resampling=Resampling.bilinear,\n",
    "        notes=\"Coarse ecological prior.\",\n",
    "    ),\n",
    "}\n",
    "\n",
    "\n",
    "def build_feature_module_registry() -> dict[str, ModuleCard]:\n",
    "    return {\n",
    "        \"features.naip.appearance\": ModuleCard(\n",
    "            name=\"features.naip.appearance\",\n",
    "            domain=PipelineDomain.FEATURES,\n",
    "            representation_target=RepresentationTarget.RASTER,\n",
    "            spatial_scope=SpatialScope.PIXEL,\n",
    "            resolution_scope=ResolutionScope.MULTI,\n",
    "            availability_tier=AvailabilityTier.UNIVERSAL,\n",
    "            runtime_tier=RuntimeTier.MODERATE,\n",
    "            description=\"NAIP spectral and textural appearance features aligned to the canonical raster grid.\",\n",
    "            inputs_required=[\"naip_raster\"],\n",
    "            outputs_produced=[\"naip_feature_layers\"],\n",
    "            strengths=[\"high local detail\", \"good boundaries\", \"strong appearance signal\"],\n",
    "            weaknesses=[\"sensitive to illumination/shadow\", \"texture can be expensive\"],\n",
    "        ),\n",
    "        \"features.als.structure\": ModuleCard(\n",
    "            name=\"features.als.structure\",\n",
    "            domain=PipelineDomain.FEATURES,\n",
    "            representation_target=RepresentationTarget.BOTH,\n",
    "            spatial_scope=SpatialScope.PIXEL,\n",
    "            resolution_scope=ResolutionScope.MULTI,\n",
    "            availability_tier=AvailabilityTier.MOST,\n",
    "            runtime_tier=RuntimeTier.EXPENSIVE,\n",
    "            description=\"ALS-derived height and structure features, rasterized and aligned to canonical grid.\",\n",
    "            inputs_required=[\"als_point_cloud_or_rasters\"],\n",
    "            outputs_produced=[\"als_feature_layers\", \"optional_object_stats\"],\n",
    "            strengths=[\"strong shrub-vs-tree structure signal\", \"height-aware\"],\n",
    "            weaknesses=[\"heavier preprocessing\", \"site coverage may vary\"],\n",
    "        ),\n",
    "        \"features.3dep.terrain\": ModuleCard(\n",
    "            name=\"features.3dep.terrain\",\n",
    "            domain=PipelineDomain.FEATURES,\n",
    "            representation_target=RepresentationTarget.RASTER,\n",
    "            spatial_scope=SpatialScope.PIXEL,\n",
    "            resolution_scope=ResolutionScope.NATIVE,\n",
    "            availability_tier=AvailabilityTier.UNIVERSAL,\n",
    "            runtime_tier=RuntimeTier.CHEAP,\n",
    "            description=\"Terrain and topographic context features from 3DEP.\",\n",
    "            inputs_required=[\"3dep_raster\"],\n",
    "            outputs_produced=[\"terrain_feature_layers\"],\n",
    "            strengths=[\"stable context\", \"cheap to compute\", \"cross-site useful\"],\n",
    "            weaknesses=[\"coarser than NAIP\", \"not directly object-boundary aware\"],\n",
    "        ),\n",
    "        \"features.rap.prior\": ModuleCard(\n",
    "            name=\"features.rap.prior\",\n",
    "            domain=PipelineDomain.FEATURES,\n",
    "            representation_target=RepresentationTarget.RASTER,\n",
    "            spatial_scope=SpatialScope.SITE,\n",
    "            resolution_scope=ResolutionScope.COARSE,\n",
    "            availability_tier=AvailabilityTier.UNIVERSAL,\n",
    "            runtime_tier=RuntimeTier.CHEAP,\n",
    "            description=\"Coarse shrub/ecological prior aligned to canonical grid.\",\n",
    "            inputs_required=[\"rap_raster\"],\n",
    "            outputs_produced=[\"rap_prior_layers\"],\n",
    "            strengths=[\"broad ecological prior\", \"site-level regularization\"],\n",
    "            weaknesses=[\"very coarse\", \"cannot drive boundaries alone\"],\n",
    "        ),\n",
    "    }\n",
    "\n",
    "\n",
    "def module_registry_frame(registry: dict[str, ModuleCard]) -> pd.DataFrame:\n",
    "    rows = []\n",
    "    for key, card in registry.items():\n",
    "        rows.append(\n",
    "            {\n",
    "                \"key\": key,\n",
    "                \"name\": card.name,\n",
    "                \"domain\": card.domain.value,\n",
    "                \"target\": card.representation_target.value,\n",
    "                \"scope\": card.spatial_scope.value,\n",
    "                \"resolution\": card.resolution_scope.value,\n",
    "                \"availability\": card.availability_tier.value,\n",
    "                \"runtime\": card.runtime_tier.value,\n",
    "                \"inputs\": \", \".join(card.inputs_required),\n",
    "                \"outputs\": \", \".join(card.outputs_produced),\n",
    "                \"description\": card.description,\n",
    "            }\n",
    "        )\n",
    "    return pd.DataFrame(rows)\n",
    "\n",
    "\n",
    "MODULE_REGISTRY = build_feature_module_registry()\n",
    "\n",
    "display(pd.DataFrame([\n",
    "    {\n",
    "        \"source\": k,\n",
    "        \"native_kind\": v.native_kind,\n",
    "        \"families\": \", \".join(v.family_names),\n",
    "        \"default_resampling\": v.default_resampling.name,\n",
    "        \"notes\": v.notes,\n",
    "    }\n",
    "    for k, v in SOURCE_SPECS.items()\n",
    "]))\n",
    "\n",
    "display(module_registry_frame(MODULE_REGISTRY))"
   ]
  },
