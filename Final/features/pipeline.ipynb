   "source": [
    "NAIP_FAMILY_RUNNERS = {\n",
    "    \"raw\": run_naip_raw_family,\n",
    "    \"veg_idx\": run_naip_veg_idx_family,\n",
    "    \"texture\": run_naip_texture_family,\n",
    "    \"multiscale\": run_naip_multiscale_family,\n",
    "    \"color_diff\": run_naip_color_diff_family,\n",
    "    \"granulometry\": run_naip_granulometry_family,\n",
    "    \"fractal\": run_naip_fractal_family,\n",
    "    \"wavelet\": run_naip_wavelet_family,\n",
    "    \"gabor\": run_naip_gabor_family,\n",
    "    \"ldp\": run_naip_ldp_family,\n",
    "    \"morphology\": run_naip_morphology_family,\n",
    "}\n",
    "\n",
    "\n",
    "def flatten_family_results(results: list[FeatureFamilyResult]) -> dict[str, np.ndarray]:\n",
    "    merged: dict[str, np.ndarray] = {}\n",
    "    for result in results:\n",
    "        overlap = set(merged).intersection(result.arrays)\n",
    "        if overlap:\n",
    "            raise ValueError(f\"Duplicate feature names detected: {sorted(overlap)}\")\n",
    "        merged.update(result.arrays)\n",
    "    return merged\n",
    "\n",
    "\n",
    "def active_naip_family_names() -> tuple[str, ...]:\n",
    "    ordered = []\n",
    "    enabled = set(fe_cfg.naip.enabled_families) | set(fe_cfg.naip.heavy_families_enabled)\n",
    "    for name in fe_cfg.enabled_families[\"naip\"]:\n",
    "        if name in enabled:\n",
    "            ordered.append(name)\n",
    "    return tuple(ordered)\n",
    "\n",
    "\n",
    "def run_naip_feature_families(\n",
    "    site_id: str,\n",
    "    *,\n",
    "    assets: SiteAssetBundle | None = None,\n",
    "    canonical_grid: CanonicalGrid | None = None,\n",
    "    family_names: tuple[str, ...] | None = None,\n",
    "    force_refresh: bool = False,\n",
    ") -> tuple[SourceRasterBundle, list[FeatureFamilyResult], dict[str, np.ndarray]]:\n",
    "    with timed_stage(\"naip_source_pipeline\", site_id=site_id, source_name=\"naip\"):\n",
    "        if assets is None:\n",
    "            assets = prepare_site_assets(site_id, force_refresh=force_refresh)\n",
    "        if canonical_grid is None:\n",
    "            canonical_grid = build_canonical_grid_for_site(site_id, assets=assets)\n",
    "\n",
    "        bundle = load_naip_source_bundle(\n",
    "            site_id,\n",
    "            assets=assets,\n",
    "            align_to_canonical=True,\n",
    "            canonical_grid=canonical_grid,\n",
    "            force_refresh=force_refresh,\n",
    "        )\n",
    "\n",
    "        family_names = family_names or active_naip_family_names()\n",
    "        log_info(\n",
    "            \"NAIP RUN | site=%s | families=%s | bundle_shape=%s | bands=%s\",\n",
    "            site_id, family_names, bundle.shape, list(bundle.arrays.keys())\n",
    "        )\n",
    "\n",
    "        total_mp = arrays_megapixels(bundle.arrays)\n",
    "        log_info(\"NAIP RUN | site=%s | approx_megapixels=%.3f\", site_id, total_mp)\n",
    "\n",
    "        results: list[FeatureFamilyResult] = []\n",
    "        for i, family_name in enumerate(family_names, start=1):\n",
    "            est_remaining = estimate_remaining_time(\n",
    "                \"naip_family\",\n",
    "                remaining_units=max(len(family_names) - i, 0) * total_mp,\n",
    "            )\n",
    "            if est_remaining is not None:\n",
    "                log_info(\n",
    "                    \"NAIP ETA | site=%s | next_family=%s | est_remaining_sec=%.2f\",\n",
    "                    site_id, family_name, est_remaining\n",
    "                )\n",
    "\n",
    "            result = run_or_load_naip_family(\n",
    "                bundle,\n",
    "                family_name,\n",
    "                force_refresh=force_refresh or fe_cfg.force_refresh_features,\n",
    "            )\n",
    "            results.append(result)\n",
    "\n",
    "            log_info(\n",
    "                \"NAIP DONE | site=%s | family=%s | n_layers=%d\",\n",
    "                site_id, family_name, len(result.arrays)\n",
    "            )\n",
    "\n",
    "        merged = flatten_family_results(results)\n",
    "\n",
    "        log_info(\n",
    "            \"NAIP MERGED | site=%s | total_families=%d | total_layers=%d\",\n",
    "            site_id, len(results), len(merged)\n",
    "        )\n",
    "\n",
    "        return bundle, results, merged"
   ]
