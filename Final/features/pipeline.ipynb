    "def infer_naip_band_names(path: str | Path) -> list[str]:\n",
    "    path = Path(path)\n",
    "    with rasterio.open(path) as src:\n",
    "        count = src.count\n",
    "\n",
    "    if count == 4:\n",
    "        return [\"red\", \"green\", \"blue\", \"nir\"]\n",
    "    if count == 3:\n",
    "        return [\"red\", \"green\", \"blue\"]\n",
    "    return [f\"band_{i}\" for i in range(1, count + 1)]\n",
    "\n",
    "\n",
    "def source_data_signature(\n",
    "    *,\n",
    "    site_id: str,\n",
    "    source_name: str,\n",
    "    asset_path: str | Path | None,\n",
    "    extra_payload: dict[str, Any] | None = None,\n",
    ") -> str:\n",
    "    payload = {\n",
    "        \"site_id\": site_id,\n",
    "        \"source_name\": source_name,\n",
    "        \"asset_path\": str(asset_path) if asset_path is not None else None,\n",
    "        \"extra\": extra_payload or {},\n",
    "    }\n",
    "    return hash_payload(payload)\n",
    "\n",
    "\n",
    "def source_config_signature(\n",
    "    *,\n",
    "    source_name: str,\n",
    "    family_names: tuple[str, ...],\n",
    "    notebook_cfg: NotebookFEConfig,\n",
    ") -> str:\n",
    "    payload = {\n",
    "        \"source_name\": source_name,\n",
    "        \"family_names\": family_names,\n",
    "        \"version\": notebook_cfg.version,\n",
    "        \"resampling\": notebook_cfg.resampling_by_source[source_name].name,\n",
    "    }\n",
    "    return hash_payload(payload)"
   ]
  },
