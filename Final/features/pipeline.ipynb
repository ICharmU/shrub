    "        assets = prepare_site_assets(site_id, force_refresh=fe_cfg.force_refresh_assets)\n",
    "\n",
    "    if assets.naip_path is None:\n",
    "        raise ValueError(f\"No NAIP path available for site={site_id}; cannot build canonical grid.\")\n",
    "\n",
    "    naip_bundle = read_raster_bundle(\n",
    "        assets.naip_path,\n",
    "        site_id=site_id,\n",
    "        source_name=\"naip\",\n",
    "        band_names=None,\n",
    "    )\n",
    "    grid = grid_from_bundle(naip_bundle)\n",
    "    LOGGER.info(\n",
    "        \"Built canonical grid for site=%s from %s | shape=(%d, %d) | pixel_size=%s\",\n",
    "        site_id,\n",
    "        assets.naip_path.name,\n",
    "        grid.height,\n",
    "        grid.width,\n",
    "        grid.pixel_size,\n",
    "    )\n",
    "    return grid"
   ]
