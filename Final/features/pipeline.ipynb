    "        source_name=\"naip\",\n",
    "        family_name=\"raw\",\n",
    "        unit_amount=arrays_megapixels(bundle.arrays),\n",
    "    ):\n",
    "        arrays = {f\"naip_raw_{k}\": v.astype(np.float32) for k, v in bundle.arrays.items()}\n",
    "        return FeatureFamilyResult(\n",
    "            site_id=bundle.site_id,\n",
    "            source_name=\"naip\",\n",
    "            family_name=\"raw\",\n",
    "            arrays=arrays,\n",
    "            metadata={\"n_layers\": len(arrays)},\n",
    "        )\n",
    "\n",
    "\n",
    "def run_naip_veg_idx_family(bundle: SourceRasterBundle) -> FeatureFamilyResult:\n",
    "    with timed_stage(\n",
    "        \"naip_family\",\n",
    "        site_id=bundle.site_id,\n",
    "        source_name=\"naip\",\n",
    "        family_name=\"veg_idx\",\n",
    "        unit_amount=arrays_megapixels(bundle.arrays),\n",
    "    ):\n",
    "        bands = bundle.arrays\n",
    "        out: dict[str, np.ndarray] = {}\n",
    "\n",
    "        red = bands.get(\"red\")\n",
    "        green = bands.get(\"green\")\n",
    "        blue = bands.get(\"blue\")\n",
    "        nir = bands.get(\"nir\")\n",
    "\n",
    "        if red is not None and nir is not None:\n",
    "            out[\"naip_idx_ndvi\"] = safe_divide(nir - red, nir + red)\n",
    "\n",
    "        if red is not None and green is not None and blue is not None:\n",
    "            out[\"naip_idx_vari\"] = safe_divide(green - red, green + red - blue)\n",
    "\n",
    "        if red is not None and green is not None:\n",
    "            out[\"naip_idx_g_minus_r\"] = (green - red).astype(np.float32)\n",
    "\n",
    "        if green is not None and blue is not None:\n",
    "            out[\"naip_idx_g_minus_b\"] = (green - blue).astype(np.float32)\n",
    "\n",
    "        return FeatureFamilyResult(\n",
    "            site_id=bundle.site_id,\n",
    "            source_name=\"naip\",\n",
    "            family_name=\"veg_idx\",\n",
    "            arrays=out,\n",
    "            metadata={\"n_layers\": len(out)},\n",
    "        )\n",
    "\n",
    "\n",
    "def run_naip_texture_family(bundle: SourceRasterBundle) -> FeatureFamilyResult:\n",
    "    base_name, base = choose_base_band(bundle)\n",
    "    base_clean = nan_to_num_copy(base)\n",
    "\n",
    "    if fe_cfg.naip.quantize_for_texture:\n",
    "        base_tex = quantize_image(base_clean, levels=fe_cfg.naip.quantize_levels)\n",
    "    else:\n",
    "        base_tex = base_clean\n",
    "\n",
    "    with timed_stage(\n",
    "        \"naip_family\",\n",
    "        site_id=bundle.site_id,\n",
    "        source_name=\"naip\",\n",
    "        family_name=\"texture\",\n",
    "        unit_amount=array_megapixels(base_clean),\n",
    "        extra={\"base_band\": base_name},\n",
    "    ):\n",
    "        out = {\n",
    "            \"naip_tex_gradmag\": gradient_magnitude(base_clean),\n",
    "            \"naip_tex_localstd_5\": local_std(base_clean, size=5),\n",
    "            \"naip_tex_entropy\": get_entropy_feature(\n",
    "                base_tex,\n",
    "                neighborhood_size=fe_cfg.naip.texture_entropy_window\n",
    "            ).astype(np.float32),\n",
    "            f\"naip_tex_lbp_r{fe_cfg.naip.texture_lbp_radius}\": get_fast_lbp_texture(\n",
    "                base_tex,\n",
    "                radius=fe_cfg.naip.texture_lbp_radius\n",
    "            ).astype(np.float32),\n",
    "        }\n",
    "\n",
    "        for size in fe_cfg.naip.texture_blur_sizes:\n",
    "            out[f\"naip_tex_blur_{size}\"] = get_uniform_blur(base_clean, neighborhood_size=size).astype(np.float32)\n",
    "\n",
    "        return FeatureFamilyResult(\n",
    "            site_id=bundle.site_id,\n",
    "            source_name=\"naip\",\n",
    "            family_name=\"texture\",\n",
    "            arrays=out,\n",
    "            metadata={\"base_band\": base_name, \"n_layers\": len(out)},\n",
    "        )\n",
    "\n",
    "\n",
    "def run_naip_multiscale_family(bundle: SourceRasterBundle) -> FeatureFamilyResult:\n",
    "    with timed_stage(\n",
    "        \"naip_family\",\n",
    "        site_id=bundle.site_id,\n",
    "        source_name=\"naip\",\n",
    "        family_name=\"multiscale\",\n",
    "        unit_amount=arrays_megapixels(bundle.arrays),\n",
    "    ):\n",
    "        bands = bundle.arrays\n",
    "        out: dict[str, np.ndarray] = {}\n",
    "\n",
    "        selected_names = [name for name in [\"red\", \"green\", \"nir\"] if name in bands]\n",
    "        if not selected_names:\n",
    "            selected_names = list(bands.keys())[:1]\n",
    "\n",
    "        for band_name in selected_names:\n",
    "            band = nan_to_num_copy(bands[band_name])\n",
    "            for size in fe_cfg.naip.multiscale_sizes:\n",
    "                out[f\"naip_ms_mean_{band_name}_{size}\"] = get_uniform_blur(band, neighborhood_size=size).astype(np.float32)\n",
    "                out[f\"naip_ms_std_{band_name}_{size}\"] = local_std(band, size=size)\n",
    "\n",
    "        return FeatureFamilyResult(\n",
    "            site_id=bundle.site_id,\n",
    "            source_name=\"naip\",\n",
    "            family_name=\"multiscale\",\n",
    "            arrays=out,\n",
    "            metadata={\"selected_bands\": selected_names, \"n_layers\": len(out)},\n",
    "        )\n",
    "\n",
    "\n",
    "def run_naip_color_diff_family(bundle: SourceRasterBundle) -> FeatureFamilyResult:\n",
    "    base_name, base = choose_base_band(bundle)\n",
    "    base_clean = nan_to_num_copy(base)\n",
    "\n",
    "    with timed_stage(\n",
    "        \"naip_family\",\n",
    "        site_id=bundle.site_id,\n",
    "        source_name=\"naip\",\n",
    "        family_name=\"color_diff\",\n",
    "        unit_amount=array_megapixels(base_clean),\n",
    "        extra={\"base_band\": base_name},\n",
    "    ):\n",
    "        out = {}\n",
    "        for kernel_name, kernel in get_simple_color_diff_kernels().items():\n",
    "            out[f\"naip_cd_{kernel_name}\"] = get_color_diff(base_clean, kernel).astype(np.float32)\n",
    "\n",
    "        return FeatureFamilyResult(\n",
    "            site_id=bundle.site_id,\n",
    "            source_name=\"naip\",\n",
    "            family_name=\"color_diff\",\n",
    "            arrays=out,\n",
    "            metadata={\"base_band\": base_name, \"n_layers\": len(out)},\n",
    "        )\n",
    "\n",
    "\n",
    "def run_naip_granulometry_family(bundle: SourceRasterBundle) -> FeatureFamilyResult:\n",
    "    base_name, base = choose_base_band(bundle)\n",
    "    base_clean = nan_to_num_copy(base)\n",
    "\n",
    "    with timed_stage(\n",
    "        \"naip_family\",\n",
    "        site_id=bundle.site_id,\n",
    "        source_name=\"naip\",\n",
    "        family_name=\"granulometry\",\n",
    "        unit_amount=array_megapixels(base_clean),\n",
    "        extra={\"base_band\": base_name},\n",
    "    ):\n",
    "        cube = get_granulometry_features(base_clean, scales=list(fe_cfg.naip.granulometry_scales))\n",
    "        out = {\n",
    "            f\"naip_gran_{i:02d}\": cube[:, :, i].astype(np.float32)\n",
    "            for i in range(cube.shape[2])\n",
    "        }\n",
    "        return FeatureFamilyResult(\n",
    "            site_id=bundle.site_id,\n",
    "            source_name=\"naip\",\n",
    "            family_name=\"granulometry\",\n",
    "            arrays=out,\n",
    "            metadata={\"base_band\": base_name, \"n_layers\": len(out)},\n",
    "        )\n",
    "\n",
    "\n",
    "def run_naip_fractal_family(bundle: SourceRasterBundle) -> FeatureFamilyResult:\n",
    "    base_name, base = choose_base_band(bundle)\n",
    "    base_clean = nan_to_num_copy(base)\n",
    "\n",
    "    with timed_stage(\n",
    "        \"naip_family\",\n",
    "        site_id=bundle.site_id,\n",
    "        source_name=\"naip\",\n",
    "        family_name=\"fractal\",\n",
    "        unit_amount=array_megapixels(base_clean),\n",
    "        extra={\"base_band\": base_name},\n",
    "    ):\n",
    "        fd_map = get_fractal_dimension_map(base_clean, scales=list(fe_cfg.naip.fractal_scales)).astype(np.float32)\n",
    "        return FeatureFamilyResult(\n",
    "            site_id=bundle.site_id,\n",
    "            source_name=\"naip\",\n",
    "            family_name=\"fractal\",\n",
    "            arrays={\"naip_frac_fd\": fd_map},\n",
    "            metadata={\"base_band\": base_name, \"n_layers\": 1},\n",
    "        )\n",
    "\n",
    "\n",
    "def run_naip_wavelet_family(bundle: SourceRasterBundle) -> FeatureFamilyResult:\n",
    "    base_name, base = choose_base_band(bundle)\n",
    "    base_clean = nan_to_num_copy(base)\n",
    "\n",
    "    with timed_stage(\n",
    "        \"naip_family\",\n",
    "        site_id=bundle.site_id,\n",
    "        source_name=\"naip\",\n",
    "        family_name=\"wavelet\",\n",
    "        unit_amount=array_megapixels(base_clean),\n",
    "        extra={\"base_band\": base_name},\n",
    "    ):\n",
    "        cube = get_wavelet_features(\n",
    "            base_clean,\n",
    "            wavelet_type=fe_cfg.naip.wavelet_type,\n",
    "            level=fe_cfg.naip.wavelet_level,\n",
    "        )\n",
    "        out = {\n",
    "            f\"naip_wav_{i:02d}\": cube[:, :, i].astype(np.float32)\n",
    "            for i in range(cube.shape[2])\n",
    "        }\n",
    "        return FeatureFamilyResult(\n",
    "            site_id=bundle.site_id,\n",
    "            source_name=\"naip\",\n",
    "            family_name=\"wavelet\",\n",
    "            arrays=out,\n",
    "            metadata={\"base_band\": base_name, \"n_layers\": len(out)},\n",
    "        )\n",
    "\n",
    "\n",
    "def run_naip_gabor_family(bundle: SourceRasterBundle) -> FeatureFamilyResult:\n",
    "    base_name, base = choose_base_band(bundle)\n",
    "    base_clean = nan_to_num_copy(base)\n",
    "\n",
    "    with timed_stage(\n",
    "        \"naip_family\",\n",
    "        site_id=bundle.site_id,\n",
    "        source_name=\"naip\",\n",
    "        family_name=\"gabor\",\n",
    "        unit_amount=array_megapixels(base_clean),\n",
    "        extra={\"base_band\": base_name},\n",
    "    ):\n",
    "        out = {}\n",
    "        idx = 0\n",
    "        for freq in fe_cfg.naip.gabor_frequencies:\n",
    "            for theta in fe_cfg.naip.gabor_thetas:\n",
    "                out[f\"naip_gabor_{idx:02d}\"] = fast_cpu_gabor(base_clean, frequency=freq, theta=theta).astype(np.float32)\n",
    "                idx += 1\n",
    "\n",
    "        return FeatureFamilyResult(\n",
    "            site_id=bundle.site_id,\n",
    "            source_name=\"naip\",\n",
    "            family_name=\"gabor\",\n",
    "            arrays=out,\n",
    "            metadata={\"base_band\": base_name, \"n_layers\": len(out)},\n",
    "        )\n",
    "\n",
    "\n",
    "def run_naip_ldp_family(bundle: SourceRasterBundle) -> FeatureFamilyResult:\n",
    "    base_name, base = choose_base_band(bundle)\n",
    "    base_clean = nan_to_num_copy(base)\n",
    "    base_tex = quantize_image(base_clean, levels=fe_cfg.naip.quantize_levels)\n",
    "\n",
    "    with timed_stage(\n",
    "        \"naip_family\",\n",
    "        site_id=bundle.site_id,\n",
    "        source_name=\"naip\",\n",
    "        family_name=\"ldp\",\n",
    "        unit_amount=array_megapixels(base_clean),\n",
    "        extra={\"base_band\": base_name},\n",
    "    ):\n",
    "        ldp = get_ldp_feature(base_tex, k=fe_cfg.naip.ldp_k).astype(np.float32)\n",
    "        return FeatureFamilyResult(\n",
    "            site_id=bundle.site_id,\n",
    "            source_name=\"naip\",\n",
    "            family_name=\"ldp\",\n",
    "            arrays={\"naip_ldp\": ldp},\n",
    "            metadata={\"base_band\": base_name, \"n_layers\": 1},\n",
    "        )\n",
    "\n",
    "\n",
    "def run_naip_morphology_family(bundle: SourceRasterBundle) -> FeatureFamilyResult:\n",
    "    base_name, base = choose_base_band(bundle)\n",
    "    base_clean = nan_to_num_copy(base)\n",
    "\n",
    "    with timed_stage(\n",
    "        \"naip_family\",\n",
    "        site_id=bundle.site_id,\n",
    "        source_name=\"naip\",\n",
    "        family_name=\"morphology\",\n",
    "        unit_amount=array_megapixels(base_clean),\n",
    "        extra={\"base_band\": base_name},\n",
    "    ):\n",
    "        out = {}\n",
    "        for size in fe_cfg.naip.morphology_window_sizes:\n",
    "            opened = grey_opening(base_clean, size=(size, size)).astype(np.float32)\n",
    "            closed = grey_closing(base_clean, size=(size, size)).astype(np.float32)\n",
    "            out[f\"naip_morph_open_{size}\"] = opened\n",
    "            out[f\"naip_morph_close_{size}\"] = closed\n",
    "            out[f\"naip_morph_open_resid_{size}\"] = (base_clean - opened).astype(np.float32)\n",
    "            out[f\"naip_morph_close_resid_{size}\"] = (closed - base_clean).astype(np.float32)\n",
    "\n",
    "        return FeatureFamilyResult(\n",
    "            site_id=bundle.site_id,\n",
    "            source_name=\"naip\",\n",
    "            family_name=\"morphology\",\n",
    "            arrays=out,\n",
    "            metadata={\"base_band\": base_name, \"n_layers\": len(out)},\n",
    "        )"
   ]
  },
